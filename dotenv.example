# Personal App

APP_NAME=Personal App

# Storage backend: "local" (SharedPreferences) or "firebase" (Firestore)
STORAGE_BACKEND=local

# Firebase Configuration — only needed when STORAGE_BACKEND=firebase
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
FIREBASE_MEASUREMENT_ID=G-0000000000

# Cloud Functions region (europe-west4 = Netherlands)
CLOUD_FUNCTIONS_REGION=europe-west4

# Emulator settings — set USE_EMULATORS=true to connect to Firebase emulators
# See dotenv.emulator for a ready-to-use emulator config
USE_EMULATORS=false
EMULATOR_HOST=localhost
