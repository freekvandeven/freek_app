rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Invite codes: no client access — only Cloud Functions (Admin SDK) can read/write
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // Users can only read/write their own data (includes private feedback).
    // Requires inviteVerified custom claim set by the createUserWithInvite function.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.inviteVerified == true;
    }

    // Public feedback — any verified authenticated user can read/write
    match /feedback/{feedbackId} {
      allow read, write: if request.auth != null
        && request.auth.token.inviteVerified == true;
    }

    // Public profiles — any verified user can read; only the profile owner can write
    match /publicProfiles/{userId} {
      allow read: if request.auth != null
        && request.auth.token.inviteVerified == true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.inviteVerified == true;
    }

    // Default deny: any path not matched above is rejected
  }
}
