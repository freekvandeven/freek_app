rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Invite codes: no client access — only Cloud Functions (Admin SDK) can read/write
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // Users can only read/write their own data (includes private feedback).
    // Requires inviteVerified custom claim set by the createUserWithInvite function.
    // Storage tracking fields (storageUsedBytes, storageLimitBytes) are read-only —
    // only Cloud Functions (Admin SDK) can modify them.
    match /users/{userId} {
      allow read: if request.auth != null
        && request.auth.token.inviteVerified == true
        && (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.inviteVerified == true
        && (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['storageUsedBytes', 'storageLimitBytes'])
            || resource == null);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.inviteVerified == true;
    }

    // Public feedback — any verified authenticated user can read/write
    match /feedback/{feedbackId} {
      allow read, write: if request.auth != null
        && request.auth.token.inviteVerified == true;
    }

    // Public profiles — any verified user can read; only the profile owner can write
    match /publicProfiles/{userId} {
      allow read: if request.auth != null
        && request.auth.token.inviteVerified == true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.inviteVerified == true;
    }

    // App config (version info, etc.) — read-only for authenticated users
    match /appConfig/{document=**} {
      allow read: if request.auth != null
        && request.auth.token.inviteVerified == true;
      allow write: if false;
    }

    // Default deny: any path not matched above is rejected
  }
}
